# Documentation only: the server reads process environment variables.
# PowerShell: $env:STRATA_PRODUCT_DATA_DIR = 'data/manual-demo/product'
STRATA_PRODUCT_DATA_DIR=data/strata
STRATA_DATA_DIR=data/dbthon_demo
STRATA_FRONTEND_ORIGIN=http://localhost:5173
# false for local HTTP; true only behind HTTPS
STRATA_SESSION_COOKIE_SECURE=false
